# Copy to .env (never commit .env). Values match docker-compose.yml.
DATABASE_URL="postgresql://missionlab:missionlab@localhost:5432/missionlab?schema=public"

# Public base URL used in email links
APP_URL="http://localhost:3000"

# SMTP: Mailpit catches every email locally (inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="MissionLab <no-reply@missionlab.local>"

# NOVA holographic assistant (server-side only; never expose with NEXT_PUBLIC_)
# Without both values NOVA uses its offline rule-based tutor.
GEMINI_API_KEY=""
# Verified available with the Gemini API at time of writing; pick any currently supported Gemini Flash / Flash-Lite model id from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional: request timeout (ms, 1000-20000), per-client requests per minute, global requests per day
NOVA_TIMEOUT_MS="8000"
NOVA_RATE_PER_MINUTE="10"
NOVA_DAILY_LIMIT="1500"

# Copy to .env (never commit .env). Values match docker-compose.yml.
DATABASE_URL="postgresql://missionlab:missionlab@localhost:5432/missionlab?schema=public"

# Public base URL used in email links
APP_URL="http://localhost:3000"

# SMTP: Mailpit catches every email locally (inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="MissionLab <no-reply@missionlab.local>"
